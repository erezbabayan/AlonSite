/* index.html — home page only. Loaded after css/shared.css. */

/* ---------------------------------------------------------------------
   Hero: an editorial diptych. The photograph holds one side, the text the
   other, each on its own surface — nothing is set over the image, so the
   type carries no shadows and the photograph is never cut by words.

   shared.css gives every page's <main> a padding-top of the measured nav
   height. The hero pulls that back off so the photograph bleeds up behind
   the frosted bar (DESIGN.md: the photography should show through the UI),
   and the text column re-adds it as padding so the words stay clear of it.
   --------------------------------------------------------------------- */
#hero {
    margin-top: calc(-1 * var(--nav-h, 4rem));
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: #eef0f2;
}

@media (min-width: 900px) {
    #hero {
        height: 100svh;
        min-height: 0;
        /* The figure comes first in the DOM so it stacks on top on phones.
           Reversing the row hands the RTL reading start — the right — to
           the text column, and sends the photograph to the left. */
        flex-direction: row-reverse;
    }
}

/* --- the photograph --- */
#hero .hero-figure {
    position: relative;
    flex: 0 0 46svh;
    overflow: hidden;
    background: #1A2E44;
}

@media (min-width: 900px) {
    #hero .hero-figure {
        flex: 1 1 auto;
    }
}

#hero .hero-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s ease-out;
    filter: saturate(0.88) contrast(1.02) brightness(0.96);
}

#hero .hero-bg-img-active {
    opacity: 1;
}

/* Grounds the caption without a line: the image simply darkens into it. */
#hero .hero-figure-scrim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 11rem;
    background: linear-gradient(to top, rgba(3, 25, 46, 0.72) 0%, rgba(3, 25, 46, 0) 100%);
    pointer-events: none;
}

#hero .hero-figure-caption {
    position: absolute;
    right: 1.5rem;
    bottom: 1.35rem;
    margin: 0;
    font-family: "Assistant", sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    color: rgba(255, 255, 255, 0.76);
}

@media (min-width: 900px) {
    #hero .hero-figure-caption {
        right: 2.25rem;
        bottom: 2rem;
    }
}

/* --- the text column --- */
#hero .hero-panel {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    background: #eef0f2;
    padding: 2.25rem 1.5rem 3rem;
    overflow-y: auto;
}

@media (min-width: 900px) {
    #hero .hero-panel {
        flex: 0 0 clamp(31rem, 42%, 37.5rem);
        padding: calc(var(--nav-h, 4rem) + 2.25rem) clamp(2.5rem, 3.4vw, 3.75rem) 2.75rem;
    }
}

#hero .hero-panel-inner {
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
    font-family: "Assistant", sans-serif;
}

/* The column is centred, so weight hung under the text lifts it: the block
   sits higher against the photograph without ever being pinned to the nav,
   and the lift scales with the viewport instead of stranding the text at
   the top of a tall screen. */
@media (min-width: 900px) {
    #hero .hero-panel-inner {
        margin-bottom: clamp(1.5rem, 7vh, 4.5rem);
    }
}

#hero .hero-kicker {
    margin: 0 0 1.2rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.34em;
    color: #C9A34E;
}

#hero .hero-title {
    margin: 0 0 1.1rem;
    font-size: clamp(1.7rem, 2.5vw + 0.55rem, 2.45rem);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: #1A2E44;
}

#hero .hero-lead {
    margin: 0 0 1rem;
    font-size: clamp(1rem, 0.45vw + 0.87rem, 1.1rem);
    line-height: 1.72;
    color: #1A2E44;
}

#hero .hero-dates {
    margin: 0 0 0.55rem;
    font-size: 0.86rem;
    line-height: 1.6;
    color: #43474d;
}

#hero .hero-years {
    margin: 0 0 1.55rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #C9A34E;
}

#hero .hero-remembrance {
    margin: 0 0 1.7rem;
    font-size: clamp(1.12rem, 0.7vw + 0.88rem, 1.35rem);
    font-weight: 600;
    line-height: 1.4;
    color: #C9A34E;
}

/* Reserves its own height so the panel never reflows when the quote fades
   out on the third slide. */
#hero .hero-quote-block {
    /* Sits well below the memorial lines — the gap is what separates his
       words from ours, so it grows with the room the panel has. */
    margin: clamp(1.5rem, 8vh, 4.5rem) 0 0;
    padding: 0;
}

/* The recessed surface lives on the fading element itself, so the block
   leaves with its background instead of stranding an empty grey box. */
#hero .hero-quote-text {
    padding: 1.3rem 1.4rem;
    background: #e1e4e8;
    transition: opacity 0.6s ease-out, visibility 0.6s ease-out;
}

#hero .hero-quote-hidden {
    opacity: 0;
    visibility: hidden;
}

/* Phones stack the panel to its natural height, so the space the hidden
   quote holds open would read as a hole above the next section. The
   fade is a desktop composition device; here the quote simply stays. */
@media (max-width: 899px) {
    #hero .hero-quote-hidden {
        opacity: 1;
        visibility: visible;
    }
}

#hero .hero-quote {
    margin: 0 0 0.7rem;
    font-size: 0.9rem;
    line-height: 1.85;
    color: #43474d;
}

#hero .hero-quote-source {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    color: #585f65;
}

/* Short laptop screens: tighten the rhythm rather than let the panel
   scroll, so the whole memorial text still lands in one view. */
@media (min-width: 900px) and (max-height: 800px) {
    #hero .hero-panel {
        padding-top: calc(var(--nav-h, 4rem) + 1.5rem);
        padding-bottom: 1.75rem;
    }
    #hero .hero-kicker { margin-bottom: 0.9rem; }
    #hero .hero-title { margin-bottom: 0.8rem; }
    #hero .hero-lead { margin-bottom: 0.75rem; }
    #hero .hero-years { margin-bottom: 1.1rem; }
    #hero .hero-remembrance { margin-bottom: 1.15rem; }
    #hero .hero-quote-text { padding: 1.05rem 1.2rem; }
    #hero .hero-quote { line-height: 1.72; }
}

/* Short enough that the lift and the quote's gap no longer fit: the whole
   memorial text still has to land in one view, so they are what give. */
@media (min-width: 900px) and (max-height: 660px) {
    #hero .hero-panel-inner { margin-bottom: 0; }
    #hero .hero-quote-block { margin-top: 1rem; }
}

img { filter: saturate(0.82) contrast(0.97) brightness(0.99); }

/* Photo frame: this page's specific shadow depth + hover lift. */
.photo-frame {
    box-shadow: 0 4px 10px rgba(27, 28, 25, 0.10);
    transition: box-shadow 400ms ease-out;
}
.photo-frame:hover {
    box-shadow: 0 8px 18px rgba(27, 28, 25, 0.15);
}
/* Reads as quiet archival grayscale until a visitor's cursor finds it,
   then color returns. Pointer-only: touch visitors see full color. */
@media (hover: hover) {
    .photo-frame .photo-frame-inner img {
        filter: grayscale(85%) contrast(1.02);
        transition: filter 600ms ease-out, transform 700ms ease-out;
    }
    .photo-frame:hover .photo-frame-inner img {
        filter: grayscale(0%);
        transform: scale(1.05);
    }
}

/* Life-chapters photos: deeper resting shadow than the shared default. */
.photo-frame-stacked {
    box-shadow: 0 14px 28px rgba(27, 28, 25, 0.16);
}

/* New candle-lighting entry sliding into the memorial list. */
@keyframes candle-in {
    from { opacity: 0; transform: translateY(12px); box-shadow: 0 0 0 rgba(124, 140, 160, 0); }
    30% { box-shadow: 0 0 24px rgba(124, 140, 160, 0.25); }
    to { opacity: 1; transform: translateY(0); box-shadow: 0 0 0 rgba(124, 140, 160, 0); }
}
.candle-entry-new {
    animation: candle-in 1400ms ease-out;
}

/* Photos quietly crossfading in one frame instead of a hard cut: each
   holds for ~3s, dissolves into the next over ~1s, on a 12s loop shared
   evenly across 3 images (4s each). Keyframe endpoints are equal (opacity 1
   at 0% and 100%) so the loop restarts with no visible jump; each image's
   delay is offset by one slot (4s) so they take turns in DOM order. */
.crossfade-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
    transform-origin: center 32%;
    animation: crossfade 12s ease-in-out infinite;
}
.life-spine-media img.is-portrait {
    object-position: center 18%;
    transform-origin: center 18%;
}
.crossfade-frame img:nth-child(2) {
    animation-delay: -4s;
}
.crossfade-frame img:nth-child(3) {
    animation-delay: -8s;
}
.crossfade-frame:has(> img:nth-child(4):last-child) img {
    animation-duration: 16s;
}
.crossfade-frame:has(> img:nth-child(4):last-child) img:nth-child(2) {
    animation-delay: -4s;
}
.crossfade-frame:has(> img:nth-child(4):last-child) img:nth-child(3) {
    animation-delay: -8s;
}
.crossfade-frame:has(> img:nth-child(4):last-child) img:nth-child(4) {
    animation-delay: -12s;
}
.crossfade-frame:has(> img:nth-child(6):last-child) img {
    animation-name: crossfade-6;
    animation-duration: 24s;
}
.crossfade-frame:has(> img:nth-child(6):last-child) img:nth-child(2) {
    animation-delay: -4s;
}
.crossfade-frame:has(> img:nth-child(6):last-child) img:nth-child(3) {
    animation-delay: -8s;
}
.crossfade-frame:has(> img:nth-child(6):last-child) img:nth-child(4) {
    animation-delay: -12s;
}
.crossfade-frame:has(> img:nth-child(6):last-child) img:nth-child(5) {
    animation-delay: -16s;
}
.crossfade-frame:has(> img:nth-child(6):last-child) img:nth-child(6) {
    animation-delay: -20s;
}
@keyframes crossfade {
    0%, 25% { opacity: 1; }
    33.333%, 91.667% { opacity: 0; }
    100% { opacity: 1; }
}
@keyframes crossfade-6 {
    0%, 12.5% { opacity: 1; }
    16.666%, 95.833% { opacity: 0; }
    100% { opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
    .crossfade-frame img {
        animation: none;
        opacity: 0;
    }
    .crossfade-frame img:first-child {
        opacity: 1;
    }
}

/* Year-spine life chapters */
.life-spine {
  padding: 5rem 1.5rem 6rem;
}

.life-spine-inner {
  max-width: 68rem;
  margin: 0 auto;
}

.life-spine-intro {
  max-width: 36rem;
  margin: 0 auto 3.5rem;
  text-align: center;
}

.life-spine-heading {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 0.85rem;
  width: max-content;
  max-width: 100%;
  margin: 0 auto;
}

.life-spine-heading-text {
  text-align: center;
}

.life-spine-emblem {
  display: block;
  height: 4.5rem;
  width: auto;
  flex-shrink: 0;
  filter: none;
}

.life-spine-range {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: baseline;
  direction: ltr;
  unicode-bidi: isolate;
  margin: 0.7rem 0 0;
}

.life-spine-stop {
  display: grid;
  grid-template-columns: 7.25rem 1.25rem minmax(0, 1fr);
  column-gap: 1.15rem;
  align-items: start;
  margin-bottom: 3.25rem;
}

.life-spine-year {
  padding-top: 0.15rem;
  text-align: left;
}

.life-spine-date {
  font-family: "Assistant", sans-serif;
  font-size: 0.92rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  color: #7C8CA0;
  margin: 0;
}

.life-spine-hebrew {
  margin: 0.28rem 0 0;
  font-size: 0.78rem;
  font-weight: 600;
  line-height: 1.45;
  color: #585f65;
}

.life-spine-rail {
  position: relative;
  justify-self: center;
  width: 0.7rem;
  min-height: 100%;
  align-self: stretch;
}

.life-spine-rail::before {
  content: "";
  position: absolute;
  top: 0.45rem;
  right: 50%;
  transform: translateX(50%);
  width: 0.7rem;
  height: 0.7rem;
  border-radius: 999px;
  background: #1A2E44;
}

.life-spine-rail::after {
  content: "";
  position: absolute;
  top: 1.35rem;
  bottom: -3.25rem;
  right: 50%;
  width: 2px;
  transform: translateX(50%);
  background: #d5d8dc;
}

.life-spine-stop-last .life-spine-rail::after {
  display: none;
}

.life-spine-title {
  font-family: "Assistant", sans-serif;
  font-size: clamp(1.45rem, 2.4vw, 1.9rem);
  font-weight: 800;
  color: #1A2E44;
  margin: 0 0 0.35rem;
  grid-column: 1 / -1;
}

.life-spine-body {
  display: grid;
  grid-template-columns: minmax(15rem, 0.95fr) minmax(0, 1.25fr);
  column-gap: 1.4rem;
  row-gap: 0.7rem;
  align-items: start;
}

.life-spine-media {
  grid-column: 1;
  grid-row: 2 / 5;
}

.life-spine-body .photo-frame {
  margin: 0;
  max-width: none;
  width: 100%;
}

.life-spine-lead {
  grid-column: 2;
  grid-row: 2;
  font-size: 1.15rem;
  font-style: italic;
  line-height: 1.7;
  color: #1A2E44;
  margin: 0;
}

.life-spine-copy {
  grid-column: 2;
  grid-row: 3;
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
  align-items: start;
}

.life-spine-text p {
  margin: 0 0 0.9rem;
  font-size: 1.05rem;
  line-height: 1.75;
  color: #585f65;
}

.life-spine-text p:last-child {
  margin-bottom: 0;
}

.life-spine-quote {
  margin: 0.45rem 0 0;
  padding: 0;
  background: none;
  border: none;
  outline: none;
}

.life-spine-quote p {
  margin: 0;
  padding: 0;
  font-size: 0.86rem;
  font-weight: 700;
  line-height: 1.5;
  color: #1A2E44;
  background: none;
  outline: none;
}

.life-spine-quote footer {
  display: block;
  margin-top: 0.22rem;
  font-size: 0.68rem;
  font-weight: 400;
  letter-spacing: 0;
  color: #7C8CA0;
}

@media (max-width: 839px) {
  .life-spine-stop {
    grid-template-columns: 1fr;
    row-gap: 0.55rem;
    margin-bottom: 2.75rem;
  }

  .life-spine-year {
    text-align: right;
  }

  .life-spine-rail {
    display: none;
  }

  .life-spine-copy {
    grid-template-columns: 1fr;
  }

  .life-spine-body {
    grid-template-columns: 1fr;
  }

  .life-spine-media,
  .life-spine-body .photo-frame,
  .life-spine-lead,
  .life-spine-copy {
    grid-column: 1;
    grid-row: auto;
  }
}
